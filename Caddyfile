# Cloudflare terminates public TLS at its edge; the site block below loads the
# *origin* cert manually, so Caddy never runs ACME and there's no global `email`
# directive to set. Set Cloudflare's SSL/TLS mode to "Full (strict)" so Cloudflare
# validates this origin cert too — that needs a Cloudflare Origin CA certificate
# (free, 15-year validity), not a Let's Encrypt one, since Let's Encrypt can't issue
# for a domain whose DNS is proxied (orange-clouded) through Cloudflare without extra
# DNS-01 plugin machinery. See docs/deploy.md for how to generate
# certs/origin-cert.pem and certs/origin-key.pem.

mosamianphotography.com, www.mosamianphotography.com {
	tls /certs/origin-cert.pem /certs/origin-key.pem

	reverse_proxy app:3000

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Public derivatives (brief section 5). Same origin cert covers this (wildcard
# *.mosamianphotography.com). Rewrites so public URLs stay clean
# (cdn.…/derivatives/x.webp) while actually hitting the app's proxy route.
cdn.mosamianphotography.com {
	tls /certs/origin-cert.pem /certs/origin-key.pem

	rewrite * /api/cdn{uri}

	# Cache-Control was previously unconditional -- a transient failure (a dead B2
	# connection, an asset mid-processing) got a 404 cached by Cloudflare as
	# "immutable, 1 year" exactly like a real success, and Cloudflare kept serving
	# that stale 404 forever after, long after the object became fetchable. Only
	# successful responses are safe to mark immutable; errors get no-store so a
	# retry can actually reach the origin again.
	#
	# The first attempt at this fix (bare `header_down @matcher ...` with no
	# handle_response) silently did NOT gate on status at all -- confirmed live via
	# `caddy adapt`: it compiled to a single unconditional header-set handler, so
	# every response, including fresh 404s, kept getting the immutable header this
	# whole time. handle_response is the actual documented mechanism for
	# conditioning on the proxied response's status.
	reverse_proxy app:3000 {
		# The app's own route (src/app/api/cdn/[...key]/route.ts) already sets
		# Cache-Control: immutable on a real 200 -- only the error path needs
		# touching here, so this only overrides on 4xx/5xx rather than also
		# re-asserting the same value Caddy would otherwise duplicate on success.
		@failure status 4xx 5xx
		handle_response @failure {
			# copy_response is required, not optional -- without it a
			# handle_response block does NOT pass the real proxied status/body
			# through at all, confirmed live: every response came back as an
			# empty 200 with no body the moment this fix first went in, because
			# nothing told Caddy to actually forward what the app returned.
			copy_response
			header Cache-Control "no-store"
		}
	}

	encode zstd gzip
}
