DATABASE_URL=
REDIS_URL=
AUTH_SECRET=
AUTH_URL=
ADMIN_EMAIL=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=
# e.g. https://cdn.mosamianphotography.com — public derivatives (Phase 3) fall back to
# same-origin /api/cdn/... if this is blank, which works but skips Cloudflare's edge
# cache entirely (every image hits the app server and B2 fresh on every request).
CDN_BASE_URL=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRINT_PROVIDER_API_KEY=

# Nightly encrypted DB backup (brief section 13) — scripts/backup-db.sh, run via VPS
# cron, not read by the app itself. B2_BACKUP_* must point at a SECOND bucket in a
# DIFFERENT region from B2_BUCKET above (a bucket-level outage or account issue
# shouldn't take out both the live originals and their backup). See docs/restore.md.
BACKUP_ENCRYPTION_KEY=
B2_BACKUP_KEY_ID=
B2_BACKUP_APPLICATION_KEY=
B2_BACKUP_BUCKET=

# SmugMug export/import (brief section 14, Phase 5) — scripts/smugmug-export/, a one-off
# local tool, not read by the deployed app. From a SmugMug API key at
# https://api.smugmug.com/api/v2/webhooks!bind (Applications), OAuth 1.0a.
SMUGMUG_API_KEY=
SMUGMUG_API_SECRET=

# docker-compose only: bootstraps the postgres container itself (brief section 18 lists
# DATABASE_URL as the single app-facing var; these three exist only so `docker compose up`
# can initialize a fresh Postgres volume — the app never reads them directly).
POSTGRES_USER=mmp
POSTGRES_PASSWORD=
POSTGRES_DB=mmp
